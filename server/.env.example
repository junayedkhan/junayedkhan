PORT=5000
MONGO_URI=your-mongodb-atlas-connection-string
JWT_SECRET=your-strong-random-secret
CLIENT_URL=https://your-netlify-site.netlify.app

# Optional on Railway: Resend email API
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_NAME=Junayed Khan Admin
EMAIL_FROM=noreply@junayedkhan.com
RESEND_FROM=noreply@junayedkhan.com

# SMTP fallback/provider. Set EMAIL_PROVIDER=smtp to force SMTP over Resend.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-password
RETURN_RESET_LINK=false
